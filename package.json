{
  "name": "jmemo-view",
  "version": "0.1.0",
  "private": true,
  "description": "SSR refactoring workspace for jwreview",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "node --watch --env-file=.env server/index.mjs",
    "server:start": "node --env-file=.env server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "env:check": "node --env-file=.env scripts/check-env.mjs",
    "db:ping": "node --env-file=.env scripts/db-ping.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lithent": "file:../lithent",
    "mongoose": "^9.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.13.9",
    "autoprefixer": "^10.4.24",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
